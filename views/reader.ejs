<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= chapter.title %> - <%= novel.title %></title>
    <meta name="description" content="<%= novel.description %>">
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="reader-body reader-theme-paper">
    <header class="reader-topbar">
      <a class="brand" href="/">
        <span class="brand-mark">渊</span>
        <span>返回首页</span>
      </a>
      <div class="reader-topbar-actions">
        <a class="button secondary small reader-mobile-hide" href="#chapter-content">正文</a>
        <button class="button secondary small" type="button" data-reader-action="toggle-directory" aria-expanded="false" aria-controls="chapter-directory">目录</button>
        <button class="button secondary small is-active" type="button" data-reader-theme="paper">白底</button>
        <button class="button secondary small" type="button" data-reader-theme="ink">黑底</button>
        <button class="button secondary small reader-advanced-control" type="button" data-reader-size="sm">小字</button>
        <button class="button secondary small is-active reader-advanced-control" type="button" data-reader-size="md">中字</button>
        <button class="button secondary small reader-advanced-control" type="button" data-reader-size="lg">大字</button>
        <button class="button secondary small reader-advanced-control" type="button" data-reader-spacing="sm">紧距</button>
        <button class="button secondary small is-active reader-advanced-control" type="button" data-reader-spacing="md">常距</button>
        <button class="button secondary small reader-advanced-control" type="button" data-reader-spacing="lg">疏距</button>
      </div>
    </header>

    <main class="reader-layout">
      <article class="reader-article" id="chapter-content">
        <div class="chapter-title">
          <p class="kicker">Chapter <%= chapter.index %></p>
          <h2><%= chapter.title %></h2>
        </div>

        <div class="chapter-content">
          <%- content %>
        </div>

        <nav class="chapter-nav" aria-label="章节切换">
          <% if (previous) { %>
            <a class="button secondary" href="<%= previous.url %>">上一章</a>
          <% } else { %>
            <span></span>
          <% } %>
          <% if (next) { %>
            <a class="button primary" href="<%= next.url %>">下一章</a>
          <% } %>
        </nav>
      </article>

      <aside class="reader-sidebar" id="chapter-directory" aria-hidden="true">
        <div class="reader-sidebar-intro">
          <img class="reader-cover" src="<%= novel.cover %>" alt="《<%= novel.title %>》封面">
          <div>
            <p class="kicker">Novel Index</p>
            <h1><%= novel.title %></h1>
            <p><%= novel.description %></p>
          </div>
        </div>
        <nav class="reader-chapters" aria-label="章节目录">
          <% novel.chapters.forEach((item) => { %>
            <a
              class="reader-chapter-link <%= item.index === chapter.index ? 'active' : '' %>"
              href="<%= item.url %>"
              data-chapter-url="<%= item.url %>"
              data-chapter-index="<%= item.index %>">
              <span class="reader-chapter-link-title"><%= item.title %></span>
              <span class="reader-chapter-link-meta">
                <% if (item.index === chapter.index) { %>
                  <span class="reader-chapter-current">当前</span>
                <% } %>
                <span class="reader-chapter-progress" data-progress-label hidden></span>
              </span>
              <span class="reader-chapter-progress-bar"><span class="reader-chapter-progress-fill" data-progress-fill></span></span>
            </a>
          <% }) %>
        </nav>
      </aside>
    </main>

    <div class="reader-progress-bar" aria-hidden="true">
      <div class="reader-progress-bar-fill" data-reader-progress></div>
    </div>

    <nav class="reader-float-nav" aria-label="快速翻章">
      <% if (previous) { %>
        <a class="button secondary small" href="<%= previous.url %>">上一章</a>
      <% } else { %>
        <span class="button secondary small is-disabled" aria-disabled="true">上一章</span>
      <% } %>
      <button class="button secondary small" type="button" data-reader-action="toggle-directory-float" aria-expanded="false" aria-controls="chapter-directory">目录</button>
      <% if (next) { %>
        <a class="button primary small" href="<%= next.url %>">下一章</a>
      <% } else { %>
        <span class="button primary small is-disabled" aria-disabled="true">下一章</span>
      <% } %>
    </nav>

    <button class="reader-resume-button" type="button" hidden data-reader-resume>
      回到上次位置
    </button>

    <script>
      (() => {
        const body = document.body;
        const sidebar = document.getElementById("chapter-directory");
        const toggleButtons = Array.from(document.querySelectorAll('[data-reader-action="toggle-directory"], [data-reader-action="toggle-directory-float"]'));
        const themeButtons = Array.from(document.querySelectorAll("[data-reader-theme]"));
        const sizeButtons = Array.from(document.querySelectorAll("[data-reader-size]"));
        const spacingButtons = Array.from(document.querySelectorAll("[data-reader-spacing]"));
        const resumeButton = document.querySelector("[data-reader-resume]");
        const progressFill = document.querySelector("[data-reader-progress]");
        const chapterLinks = Array.from(document.querySelectorAll("[data-chapter-url]"));
        const themeKey = "yuan-reader-theme";
        const sizeKey = "yuan-reader-size";
        const spacingKey = "yuan-reader-spacing";
        const progressKey = `yuan-reader-progress:${window.location.pathname}`;
        const validThemes = new Set(["paper", "ink"]);
        const validSizes = new Set(["sm", "md", "lg"]);
        const validSpacing = new Set(["sm", "md", "lg"]);

        const applyTheme = (theme) => {
          const nextTheme = validThemes.has(theme) ? theme : "paper";
          body.classList.remove("reader-theme-paper", "reader-theme-ink");
          body.classList.add(`reader-theme-${nextTheme}`);
          themeButtons.forEach((button) => {
            button.classList.toggle("is-active", button.dataset.readerTheme === nextTheme);
          });
          window.localStorage.setItem(themeKey, nextTheme);
        };

        const applySize = (size) => {
          const nextSize = validSizes.has(size) ? size : "md";
          body.classList.remove("reader-size-sm", "reader-size-md", "reader-size-lg");
          body.classList.add(`reader-size-${nextSize}`);
          sizeButtons.forEach((button) => {
            button.classList.toggle("is-active", button.dataset.readerSize === nextSize);
          });
          window.localStorage.setItem(sizeKey, nextSize);
        };

        const applySpacing = (spacing) => {
          const nextSpacing = validSpacing.has(spacing) ? spacing : "md";
          body.classList.remove("reader-spacing-sm", "reader-spacing-md", "reader-spacing-lg");
          body.classList.add(`reader-spacing-${nextSpacing}`);
          spacingButtons.forEach((button) => {
            button.classList.toggle("is-active", button.dataset.readerSpacing === nextSpacing);
          });
          window.localStorage.setItem(spacingKey, nextSpacing);
        };

        const setDirectoryOpen = (open) => {
          body.classList.toggle("reader-directory-open", open);
          sidebar.setAttribute("aria-hidden", open ? "false" : "true");
          toggleButtons.forEach((button) => {
            button.setAttribute("aria-expanded", open ? "true" : "false");
          });
        };

        const readChapterProgress = (chapterUrl) => {
          try {
            const raw = window.localStorage.getItem(`yuan-reader-progress:${chapterUrl}`);
            if (!raw) return null;
            const parsed = JSON.parse(raw);
            if (typeof parsed.ratio !== "number") return null;
            return parsed;
          } catch (error) {
            return null;
          }
        };

        const paintChapterProgress = () => {
          chapterLinks.forEach((link) => {
            const progress = readChapterProgress(link.dataset.chapterUrl);
            const label = link.querySelector("[data-progress-label]");
            const fill = link.querySelector("[data-progress-fill]");
            if (!label || !fill) return;
            if (!progress || progress.ratio <= 0.02) {
              label.hidden = true;
              fill.style.width = "0%";
              link.classList.remove("is-read");
              return;
            }
            const percent = Math.max(1, Math.min(100, Math.round(progress.ratio * 100)));
            fill.style.width = `${percent}%`;
            label.hidden = false;
            label.textContent = `${percent}%`;
            link.classList.add("is-read");
          });
        };

        toggleButtons.forEach((button) => {
          button.addEventListener("click", () => {
            setDirectoryOpen(!body.classList.contains("reader-directory-open"));
          });
        });

        themeButtons.forEach((button) => {
          button.addEventListener("click", () => applyTheme(button.dataset.readerTheme));
        });

        sizeButtons.forEach((button) => {
          button.addEventListener("click", () => applySize(button.dataset.readerSize));
        });

        spacingButtons.forEach((button) => {
          button.addEventListener("click", () => applySpacing(button.dataset.readerSpacing));
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && body.classList.contains("reader-directory-open")) {
            setDirectoryOpen(false);
          }
        });

        const savedTheme = window.localStorage.getItem(themeKey);
        const savedSize = window.localStorage.getItem(sizeKey);
        const savedSpacing = window.localStorage.getItem(spacingKey);
        applyTheme(savedTheme || "paper");
        applySize(savedSize || "md");
        applySpacing(savedSpacing || "md");
        setDirectoryOpen(false);

        const readProgress = () => {
          const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 0);
          const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
          const ratio = maxScroll > 0 ? Math.min(scrollTop / maxScroll, 1) : 0;
          progressFill.style.width = `${ratio * 100}%`;
          window.localStorage.setItem(progressKey, JSON.stringify({ top: scrollTop, ratio }));
          resumeButton.hidden = scrollTop < 120;
          paintChapterProgress();
        };

        const currentProgress = readChapterProgress(window.location.pathname);
        const savedProgress = currentProgress && typeof currentProgress.top === "number" ? currentProgress.top : 0;
        if (savedProgress > 480) {
          resumeButton.hidden = false;
          resumeButton.addEventListener("click", () => {
            window.scrollTo({ top: savedProgress, behavior: "smooth" });
          });
        }

        window.addEventListener("scroll", readProgress, { passive: true });
        window.addEventListener("beforeunload", readProgress);
        paintChapterProgress();
        readProgress();
      })();
    </script>
  </body>
</html>
