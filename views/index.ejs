<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= novel.title %> - LQS Home</title>
    <meta name="description" content="<%= novel.description %>">
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href="/">
          <span class="brand-mark">渊</span>
          <span>LQS Home</span>
        </a>
        <nav class="nav-links" aria-label="主导航">
          <a href="#novel">小说</a>
          <% site.sections.forEach((section) => { %>
            <a href="#<%= section.id %>"><%= section.title %></a>
          <% }) %>
          <a href="#contact">联系</a>
        </nav>
      </header>

      <main>
        <section id="novel" class="novel-hero">
          <div class="book-cover-wrap">
            <a class="book-cover-link" href="<%= novel.firstChapterUrl %>" aria-label="开始阅读《<%= novel.title %>》">
              <img class="book-cover" src="<%= novel.cover %>" alt="《<%= novel.title %>》封面">
            </a>
          </div>

          <div class="novel-intro">
            <p class="eyebrow"><%= site.hero.eyebrow %></p>
            <h1><%= novel.title %></h1>
            <p class="tagline"><%= novel.tagline %></p>
            <p class="intro-copy"><%= novel.description %></p>

            <div class="novel-meta" aria-label="小说信息">
              <span><%= novel.genre %></span>
              <span><%= novel.status %></span>
              <span><%= novel.latest %></span>
            </div>

            <div class="hero-actions">
              <a class="button primary" href="<%= novel.firstChapterUrl %>">开始阅读</a>
              <a class="button secondary" href="#chapter-list">查看目录</a>
            </div>
          </div>
        </section>

        <section id="chapter-list" class="chapter-panel">
          <div class="section-head">
            <p class="kicker">Novel Index</p>
            <h2>《<%= novel.title %>》目录</h2>
            <p>已收录 <%= novel.chapters.length %> 章。点击任意章节就能进入阅读页。</p>
          </div>

          <div class="chapter-grid">
            <% novel.chapters.forEach((chapter) => { %>
              <a class="chapter-card" href="<%= chapter.url %>">
                <span>第 <%= chapter.index %> 章</span>
                <strong><%= chapter.title.replace(/^第\d+章\s*/, "") %></strong>
              </a>
            <% }) %>
          </div>
        </section>

        <% site.sections.forEach((section) => { %>
          <section id="<%= section.id %>" class="content-section">
            <div class="section-head">
              <p class="kicker"><%= section.kicker %></p>
              <h2><%= section.title %></h2>
              <p><%= section.description %></p>
            </div>

            <div class="feature-grid">
              <% section.items.forEach((item) => { %>
                <article class="feature-card">
                  <p class="card-meta"><%= item.meta %></p>
                  <h3><%= item.name %></h3>
                  <p><%= item.summary %></p>
                </article>
              <% }) %>
            </div>
          </section>
        <% }) %>

        <section id="contact" class="contact-section">
          <div class="section-head">
            <p class="kicker">Message</p>
            <h2>给我留言</h2>
            <p>想交流小说、测试项目或工具想法，可以从这里发消息。</p>
          </div>

          <% if (submitted) { %>
            <div class="notice">留言已保存到服务器。</div>
          <% } %>

          <form class="contact-form" method="post" action="/contact">
            <label>
              <span>名字</span>
              <input type="text" name="name" placeholder="怎么称呼你" required>
            </label>
            <label>
              <span>邮箱</span>
              <input type="email" name="email" placeholder="your@email.com" required>
            </label>
            <label class="full">
              <span>留言内容</span>
              <textarea name="message" rows="6" placeholder="写下你想说的话。" required></textarea>
            </label>
            <button class="button primary" type="submit">发送留言</button>
          </form>
        </section>
      </main>
    </div>
  </body>
</html>
