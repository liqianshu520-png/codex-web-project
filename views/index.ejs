<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= novel.title %> - 小说站</title>
    <meta name="description" content="<%= novel.description %>">
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="ink-home">
    <% const showChapters = novel.status !== "筹备中" && novel.latest !== "暂未上线" && novel.chapters.length > 0; %>
    <div class="site-shell">
      <header class="topbar ink-topbar">
        <a class="brand" href="/">
          <span class="brand-mark">渊</span>
          <span>渊 · 小说站</span>
        </a>
        <nav class="nav-links" aria-label="主导航">
          <a href="#novel">卷首</a>
          <a href="#mood">气韵</a>
          <a href="#characters">人物</a>
          <a href="#gallery">图集</a>
          <a href="#chapter-list">目录</a>
        </nav>
      </header>

      <main>
        <section id="novel" class="ink-hero">
          <img class="ink-hero-bg" src="/assets/novels/ink/jianghu-panorama.png" alt="水墨山河">
          <div class="ink-hero-shade"></div>
          <div class="ink-hero-copy">
            <p class="eyebrow"><%= site.hero.eyebrow %></p>
            <h1><%= novel.title %></h1>
            <p class="tagline"><%= novel.tagline %></p>
            <p class="intro-copy"><%= novel.description %></p>
            <div class="novel-meta" aria-label="小说信息">
              <span><%= novel.genre %></span>
              <span><%= novel.status %></span>
              <span><%= novel.latest %></span>
            </div>
            <div class="hero-actions">
              <% if (showChapters) { %>
                <a class="button primary" href="<%= novel.firstChapterUrl %>">开始阅读</a>
                <a class="button secondary" href="#chapter-list">查看目录</a>
              <% } else { %>
                <span class="button primary is-disabled">新作筹备中</span>
                <a class="button secondary" href="#gallery">先看图卷</a>
              <% } %>
            </div>
          </div>
        </section>

        <section id="mood" class="ink-section mood-section">
          <div class="section-head">
            <p class="kicker">Ink Prelude</p>
            <h2>山水已开，故事仍有雾气</h2>
            <p>正文重新上架后，江湖的气息先从这里铺开：远山、竹影、舟子、纸上未干的墨。读者进门，先看见这口气，再翻进成都府的雨。</p>
          </div>
          <div class="mood-grid">
            <article class="mood-card mood-card-wide">
              <img src="/assets/novels/ink/mist-river-wide.png" alt="烟雨江河">
              <div>
                <span>江河</span>
                <strong>一叶入水，万山无声</strong>
              </div>
            </article>
            <article class="mood-card">
              <img src="/assets/novels/ink/river-valley.png" alt="山谷水墨">
              <div>
                <span>山谷</span>
                <strong>竹影压岸，旧路生寒</strong>
              </div>
            </article>
          </div>
        </section>

        <section id="characters" class="ink-section character-section">
          <div class="section-head">
            <p class="kicker">Figures</p>
            <h2>人物照影</h2>
            <p>人物图先作为新书视觉基调保留。后面角色定稿后，可以把这里改成人物档案、出场章回和关系线。</p>
          </div>

          <div class="character-grid">
            <article class="character-card tall">
              <img src="/assets/novels/ink/woman-writing.png" alt="执笔女子">
              <div class="character-caption">
                <span>案前</span>
                <strong>灯下未落的一笔</strong>
              </div>
            </article>
            <article class="character-card">
              <img src="/assets/novels/ink/woman-bamboo.png" alt="竹影女子">
              <div class="character-caption">
                <span>竹下</span>
                <strong>绿竹无尘，宁静致远</strong>
              </div>
            </article>
            <article class="character-card">
              <img src="/assets/novels/ink/woman-portrait.png" alt="水墨人物">
              <div class="character-caption">
                <span>风月</span>
                <strong>清风明月，旧梦未央</strong>
              </div>
            </article>
          </div>
        </section>

        <section id="gallery" class="ink-section gallery-section">
          <div class="section-head">
            <p class="kicker">Novel Gallery</p>
            <h2>小说图片区</h2>
            <p>这里可以放封面、人物图、地图、场景图和你想给读者看的视觉资料。</p>
          </div>

          <div class="gallery-layout">
            <div class="gallery-upload-card">
              <h3>上传新图片</h3>
              <p>支持 JPG / PNG / WEBP / GIF，单张不超过 50MB。上传后会直接出现在下方图集中。</p>

              <% if (uploadSuccess) { %>
                <div class="notice">图片已经上传好了。</div>
              <% } %>

              <% if (uploadError === "size") { %>
                <div class="notice notice-error">这张图太大了。现在单张上限是 50MB，压小一点再传就行。</div>
              <% } %>

              <% if (uploadError === "format") { %>
                <div class="notice notice-error">这次上传没成功，请确认图片格式是 JPG、PNG、WEBP 或 GIF。</div>
              <% } %>

              <% if (uploadError === "missing") { %>
                <div class="notice notice-error">站点没有收到这张图。你可以重新选一次图片再上传。</div>
              <% } %>

              <form class="gallery-upload-form" method="post" action="/novels/yuan/gallery" enctype="multipart/form-data">
                <label class="full">
                  <span>选择图片</span>
                  <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" required>
                </label>
                <button class="button primary" type="submit">上传到图集</button>
              </form>
            </div>

            <div class="gallery-grid">
              <% if (gallery.length === 0) { %>
                <article class="gallery-empty">
                  <h3>图集还是空的</h3>
                  <p>你上传第一张图之后，这里就会开始显示。</p>
                </article>
              <% } %>

              <% gallery.forEach((image) => { %>
                <article class="gallery-card">
                  <a href="<%= image.url %>" target="_blank" rel="noreferrer">
                    <img src="<%= image.url %>" alt="<%= image.name %>">
                  </a>
                  <div class="gallery-card-body">
                    <strong><%= image.name %></strong>
                    <span><%= image.uploadedLabel %></span>
                  </div>
                </article>
              <% }) %>
            </div>
          </div>
        </section>

        <section id="chapter-list" class="ink-section chapter-panel">
          <div class="section-head">
            <p class="kicker">Novel Index</p>
            <h2>《<%= novel.title %>》目录</h2>
            <% if (showChapters) { %>
              <p>已收录 <%= novel.chapters.length %> 章。点击任意章节就能进入阅读页。</p>
            <% } else { %>
              <p>当前线上正文已经清空，新小说整理好后会从这里重新上架。</p>
            <% } %>
          </div>

          <% if (showChapters) { %>
            <div class="chapter-grid">
              <% novel.chapters.forEach((chapter) => { %>
                <a class="chapter-card" href="<%= chapter.url %>">
                  <span>第 <%= chapter.index %> 章</span>
                  <strong><%= chapter.title.replace(/^第\d+章\s*/, "") %></strong>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <article class="chapter-empty">
              <h3>旧章节已全部下架</h3>
              <p>你现在看到的是干净的发站状态。后面等新小说准备好，我们再把新的章节一批批挂上来。</p>
            </article>
          <% } %>
        </section>

        <section id="contact" class="ink-section contact-section">
          <div class="section-head">
            <p class="kicker">Message</p>
            <h2>给我留言</h2>
            <p>想聊剧情、人物、设定，或者给这部小说提意见，可以从这里发消息。</p>
          </div>

          <% if (submitted) { %>
            <div class="notice">留言已保存到服务器。</div>
          <% } %>

          <form class="contact-form" method="post" action="/contact">
            <label>
              <span>名字</span>
              <input type="text" name="name" placeholder="怎么称呼你" required>
            </label>
            <label>
              <span>邮箱</span>
              <input type="email" name="email" placeholder="your@email.com" required>
            </label>
            <label class="full">
              <span>留言内容</span>
              <textarea name="message" rows="6" placeholder="写下你想说的话。" required></textarea>
            </label>
            <button class="button primary" type="submit">发送留言</button>
          </form>
        </section>
      </main>
    </div>
  </body>
</html>
